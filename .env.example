# Public Supabase settings used by the Vercel frontend
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional alternative name for the same public browser-safe key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Keep GROQ_API_KEY in Supabase Dashboard > Edge Functions > Secrets.
# Never prefix the Groq key with NEXT_PUBLIC_ or commit it to this file.
