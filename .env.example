# Supabase project settings (authentication/persistence phase)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Client-side public URL for the separate Python/OASIS worker.
# Set this in Vercel after the Render worker has been deployed.
NEXT_PUBLIC_SIMULATION_BACKEND_URL=

# Server-side provider settings for the legacy single-call fallback route.
# The OASIS worker needs these same provider settings in its own Render environment.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=replace-with-provider-key
LLM_MODEL_NAME=openai/gpt-oss-20b
MAX_SIMULATION_AGENTS=5
MAX_SIMULATION_ROUNDS=2
